# JS shell configuration used by .github/workflows/codspeed.yml.
# The toolchain comes from the runner image and the workflow's setup steps, so
# no taskcluster toolchain fetching.
ac_add_options --enable-project=js
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-bootstrap
ac_add_options --with-ccache=sccache

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-codspeed
mk_add_options AUTOCLOBBER=1
